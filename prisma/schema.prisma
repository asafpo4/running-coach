// Prisma schema for the AI Running Coach app.
// Datasource is Supabase Postgres (free tier). DATABASE_URL uses the pooled
// connection (port 6543, pgbouncer) for app queries; DIRECT_URL uses the
// direct connection (port 5432) for migrations. Both come from the same
// Supabase project's Connection Info page.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProviderType {
  strava
  garmin
  google_calendar
}

enum PlanStatus {
  active
  completed
  abandoned
}

enum WorkoutType {
  easy
  tempo
  interval
  long
  rest
}

enum ChatRole {
  user
  coach
}

// Supabase Auth owns the actual user/credentials table (auth.users). This
// model mirrors it 1:1 by id so the rest of the schema can use normal
// relations; a DB trigger (see supabase/README) inserts a row here whenever
// a new auth.users row is created.
model User {
  // Matches auth.users.id 1:1 — populated by the trigger in
  // supabase/sync-user-trigger.sql, never generated by Prisma.
  id        String   @id
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")

  goals             Goal[]
  providerConns     ProviderConnection[]
  activities        Activity[]
  trainingPlans     TrainingPlan[]
  chatMessages      ChatMessage[]

  @@map("users")
}

model Goal {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  // At least one of these two is required (enforced in the server action,
  // not the DB) — either alone is a valid goal, together they imply a pace.
  targetDistanceMeters Float?    @map("target_distance_meters")
  targetTimeSeconds    Int?      @map("target_time_seconds")
  targetDate           DateTime? @map("target_date")
  trainingDays         String[]  @map("training_days") // e.g. ["mon", "wed", "sat"]
  createdAt            DateTime  @default(now()) @map("created_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plans TrainingPlan[]

  @@map("goals")
}

model ProviderConnection {
  id                String       @id @default(uuid())
  userId            String       @map("user_id")
  provider          ProviderType
  accessToken       String       @map("access_token")
  refreshToken      String?      @map("refresh_token")
  expiresAt         DateTime?    @map("expires_at")
  providerAthleteId String?      @map("provider_athlete_id")
  createdAt         DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("provider_connections")
}

model Activity {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  provider           ProviderType
  providerActivityId String   @map("provider_activity_id")
  date               DateTime
  distanceMeters     Float    @map("distance_meters")
  durationSeconds    Int      @map("duration_seconds")
  avgPaceSecPerKm    Float?   @map("avg_pace_sec_per_km")
  avgHeartRate       Int?     @map("avg_heart_rate")
  elevationGainM     Float?   @map("elevation_gain_m")
  raw                Json?
  createdAt          DateTime @default(now()) @map("created_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedWorkout   PlannedWorkout?

  @@unique([provider, providerActivityId])
  @@map("activities")
}

model TrainingPlan {
  id          String     @id @default(uuid())
  userId      String     @map("user_id")
  goalId      String     @map("goal_id")
  status      PlanStatus @default(active)
  version     Int        @default(1)
  generatedAt DateTime   @default(now()) @map("generated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal     Goal             @relation(fields: [goalId], references: [id], onDelete: Cascade)
  workouts PlannedWorkout[]

  @@map("training_plans")
}

model PlannedWorkout {
  id                  String      @id @default(uuid())
  planId              String      @map("plan_id")
  date                DateTime
  type                WorkoutType
  targetDistanceMeters Float?     @map("target_distance_meters")
  targetPaceSecPerKm  Float?      @map("target_pace_sec_per_km")
  completedActivityId String?     @unique @map("completed_activity_id")
  calendarEventId     String?     @map("calendar_event_id")

  plan              TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  completedActivity Activity?    @relation(fields: [completedActivityId], references: [id], onDelete: SetNull)

  @@map("planned_workouts")
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  role      ChatRole
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

# Local dev secrets — never commit this file (.gitignore already excludes .env*).
# Copy this file to .env.local (or .env) and fill in real values.

# --- Supabase Postgres (Project Settings -> Database -> Connection string) ---
# Pooled connection (pgbouncer, port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:YOUR_DB_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used only by `prisma migrate`.
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:YOUR_DB_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Supabase Auth (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Google Gemini API (https://aistudio.google.com/apikey — free tier) ---
GEMINI_API_KEY="your-gemini-api-key"

# --- Strava API (https://www.strava.com/settings/api) ---
STRAVA_CLIENT_ID="your-strava-client-id"
STRAVA_CLIENT_SECRET="your-strava-client-secret"
STRAVA_REDIRECT_URI="http://localhost:3000/api/strava/callback"

# --- Google Calendar API (Google Cloud Console OAuth client) ---
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/calendar/callback"

# App URL (used to build OAuth redirect/callback links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
